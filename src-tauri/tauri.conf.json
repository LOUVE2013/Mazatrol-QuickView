{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mazatrol QuickView Prototype",
  "version": "0.1.23",
  "identifier": "pl.mazatrol.quickview.desktop.prototype",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mazatrol QuickView — prototyp desktopowy",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
